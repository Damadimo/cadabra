# Copy to .env (never commit .env).

# Baseten API key: app.baseten.co -> Settings -> API keys
BASETEN_API_KEY=

# Task adapter: insurance (default) or seclogs
UNDERSTUDY_TASK=insurance

# Fill in after `baseten train checkpoint deploy`:
# UNDERSTUDY_BASE_URL=https://model-<model_id>.api.baseten.co/environments/production/sync/v1
# UNDERSTUDY_MODEL=checkpoint-<step>
# UNDERSTUDY_GPU_HOURLY=6.50
# UNDERSTUDY_JSON_SCHEMA=1

# Lanes shown in the live race, left to right
# RACE_LANES=specialist,kimi-k3,glm-5.3

# Reasoning effort for the frontier lanes (see docs.baseten.co/inference/model-apis/reasoning)
# K3_EFFORT=low
# GLM_EFFORT=low

# Requests/min per model we allow ourselves. Unverified accounts: 15. Verified: 120.
# BASETEN_RPM=100

# Pin the scoreboard to one eval run instead of the newest
# SCOREBOARD=runs/<run>/summary.json

# Mock mode, no credits used (run `uv run python scripts/mock_openai.py` first):
# BASETEN_BASE_URL=http://127.0.0.1:8001/v1
# UNDERSTUDY_BASE_URL=http://127.0.0.1:8001/v1
