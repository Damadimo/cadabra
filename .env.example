# Copy to .env (never commit .env).

# Baseten API key: app.baseten.co -> Settings -> API keys
BASETEN_API_KEY=

# Filled in after `baseten train checkpoint deploy` (see training/deploy_config.py):
# CADABRA_BASE_URL=https://model-<model_id>.api.baseten.co/environments/production/sync/v1
# CADABRA_MODEL=checkpoint-<step>
# CADABRA_GPU_HOURLY=6.50

# Lanes in the live race (named lanes or any Model API slug as slug:effort)
# RACE_LANES=specialist,moonshotai/Kimi-K3:high,zai-org/GLM-5.3-Flash:high

# Requests/min per model we allow ourselves. Unverified accounts: 15. Verified: 120.
# BASETEN_RPM=13

# Per-request timeout in seconds (high-effort reasoning can run for minutes)
# LLM_TIMEOUT=1800

# Pin the scoreboard to one benchmark run instead of the newest
# SCOREBOARD=runs/<run>/summary.json

# Mock mode, no credits used (run `uv run python scripts/mock_openai.py` first):
# BASETEN_BASE_URL=http://127.0.0.1:8001/v1
# CADABRA_BASE_URL=http://127.0.0.1:8001/v1
